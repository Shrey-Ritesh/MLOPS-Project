# Copy to .env and fill in. Never commit .env.

# Required: Groq API key used by the tutor frontend.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default chat model (llama-3.3-70b-versatile).
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: override the Chroma endpoint from configs/retrieval.yaml and
# configs/jee_retrieval_v1.yaml (needed when the app runs in a container).
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# Optional: MLflow tracking server (defaults to the local sqlite store).
# MLFLOW_TRACKING_URI=http://localhost:5000
