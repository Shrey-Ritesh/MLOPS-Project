# Groq API Key for LLM response generation in the JEE Tutor app
GROQ_API_KEY=your_groq_api_key_here

# Groq model name
GROQ_MODEL=openai/gpt-oss-120b

# OCR.space API Key for handwritten answer transcription
OCR_SPACE_API_KEY=your_ocr_space_api_key_here


# Secret used to pseudonymise learner IDs in the prediction log (at least 16 characters).
# Generate once with: python -c "import secrets; print(secrets.token_hex(32))"
# Never change it during the project: old and new rows for a learner would stop matching.
LOG_PSEUDONYM_KEY=your_log_pseudonym_key_here


# Optional: override the Chroma endpoint from configs/*.yaml (docker-compose sets
# these to the internal "chroma" service).
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# Optional: MLflow tracking server (defaults to the local sqlite store).
# MLFLOW_TRACKING_URI=http://localhost:5000
